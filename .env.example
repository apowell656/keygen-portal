# Pinned upstream Portal source. Do not use "master" in production.
KEYGEN_PORTAL_COMMIT=6e1fca766ba4e9b8322fbf7cfdc7c2134e6cc782

# Public hostname where Caddy will serve Portal.
PORTAL_HOST=portal.example.com

# Keygen API build configuration. These VITE_* values are compiled into the
# frontend bundle and must not contain secrets.
VITE_KEYGEN_HOST=licensing.example.com
VITE_KEYGEN_VERSION=1.8
VITE_KEYGEN_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
VITE_KEYGEN_EDITION=CE
VITE_KEYGEN_MODE=singleplayer

# Defaults to token when omitted. Keep token unless the Keygen API is explicitly
# configured for browser cookie/session authentication.
VITE_KEYGEN_AUTHENTICATION_SCHEME=token

# Optional support email displayed by Portal.
# VITE_KEYGEN_SUPPORT_EMAIL=support@example.com
